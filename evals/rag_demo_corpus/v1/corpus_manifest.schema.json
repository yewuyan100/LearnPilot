{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-demo-corpus-manifest-v1.schema.json",
  "title": "LearnPilot RAG Demo Corpus Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "corpus_version", "documents"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_id": {"const": "learnpilot-rag-demo-corpus"},
    "corpus_version": {"const": "v1"},
    "documents": {
      "type": "array",
      "minItems": 10,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "title",
        "topic",
        "source_type",
        "source_reference",
        "version_or_date",
        "language",
        "expected_ingestion_type",
        "repository_path",
        "sha256",
        "notes"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^lp-rag-v1-[a-d][0-9]{2}$"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "topic": {
          "enum": [
            "rag_retrieval",
            "agent_engineering",
            "ai_app_backend",
            "evaluation_production_reliability"
          ]
        },
        "source_type": {
          "enum": ["project_owned_runtime_contract", "project_owned_operational_guide"]
        },
        "source_reference": {"type": "string", "minLength": 1},
        "version_or_date": {"type": "string", "format": "date"},
        "language": {"const": "zh-CN"},
        "expected_ingestion_type": {"const": "md"},
        "repository_path": {
          "type": "string",
          "pattern": "^evals/rag_demo_corpus/v1/corpus/[a-z0-9-]+\\.md$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
