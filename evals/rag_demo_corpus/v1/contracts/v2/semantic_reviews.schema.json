{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-semantic-reviews-v2.schema.json",
  "title": "LearnPilot RAG Human-Reviewed Semantic Contract V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_version", "baseline_run_id", "corpus_ref", "case_count", "cases"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "review_version": {"const": "v2.0.0"},
    "baseline_run_id": {"const": "20260813T095948Z-f8aaaae2"},
    "corpus_ref": {"type": "object"},
    "case_count": {"const": 48},
    "cases": {
      "type": "array", "minItems": 48, "maxItems": 48,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "frozen_answer", "expected_answerable", "actual_answerable", "answerability_correct", "claim_reviews", "citation_reviews", "case_verdict", "reviewer_mode", "review_version", "review_notes"],
        "properties": {
          "case_id": {"type": "string"},
          "frozen_answer": {"type": "string"},
          "expected_answerable": {"type": "boolean"},
          "actual_answerable": {"type": "boolean"},
          "answerability_correct": {"type": "boolean"},
          "claim_reviews": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["case_id", "claim_id", "verdict", "supporting_answer_span", "supporting_document_ids", "review_reason", "reviewer_mode", "review_version"],
              "properties": {
                "case_id": {"type": "string"},
                "claim_id": {"type": "string"},
                "verdict": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "NOT_SUPPORTED", "CONTRADICTED", "AMBIGUOUS_GOLD"]},
                "supporting_answer_span": {"type": "string"},
                "supporting_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "review_reason": {"type": "string", "minLength": 1},
                "reviewer_mode": {"enum": ["HUMAN", "AI_ASSISTED_MANUAL"]},
                "review_version": {"type": "string", "minLength": 1}
              }
            }
          },
          "citation_reviews": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["document_id", "evidence_role", "materially_supports_answer", "review_reason"],
              "properties": {
                "document_id": {"type": "string"},
                "evidence_role": {"enum": ["REQUIRED", "ACCEPTABLE_SUPPORT", "UNSUPPORTED"]},
                "materially_supports_answer": {"type": "boolean"},
                "review_reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "case_verdict": {"enum": ["PASS", "FAIL"]},
          "reviewer_mode": {"enum": ["HUMAN", "AI_ASSISTED_MANUAL"]},
          "review_version": {"type": "string"},
          "review_notes": {"type": "string"}
        }
      }
    }
  }
}
