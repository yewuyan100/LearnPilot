{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-eval-gold-contract-v2.schema.json",
  "title": "LearnPilot RAG Eval and Gold Contract V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "corpus_ref", "case_count", "cases"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "contract_id": {"const": "learnpilot-rag-eval-gold-contract-v2"},
    "corpus_ref": {"$ref": "#/$defs/corpus_ref"},
    "case_count": {"const": 48},
    "cases": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "document_id": {"type": "string", "pattern": "^lp-rag-v1-[a-d][0-9]{2}$"},
    "corpus_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "corpus_version"],
      "properties": {
        "corpus_id": {"const": "learnpilot-rag-demo-corpus"},
        "corpus_version": {"const": "v1"}
      }
    },
    "evidence_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_group_id", "required", "any_of_document_ids", "notes"],
      "properties": {
        "evidence_group_id": {"type": "string", "pattern": "^eg-[a-z0-9-]+$"},
        "required": {"type": "boolean"},
        "any_of_document_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/document_id"}
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "canonical_claim", "required", "evidence_group_ids", "evaluation_mode", "notes"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^rag-v1-[a-z0-9-]+-claim-[0-9]{2}$"},
        "canonical_claim": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "evidence_group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evaluation_mode": {"enum": ["STRUCTURED_EXACT", "NUMERIC_EXACT", "IDENTIFIER_EXACT", "SEMANTIC_REVIEW", "ANSWERABILITY_ONLY"]},
        "deterministic_match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "all_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "ordered_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "question", "difficulty", "type", "answerable", "evidence_groups", "acceptable_supporting_document_ids", "irrelevant_or_disallowed_document_ids", "claims", "citation_contract", "v1_trace", "gold_review"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^rag-v1-[a-z0-9-]+$"},
        "question": {"type": "string", "minLength": 4},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "type": {"enum": ["single_doc_fact", "semantic_paraphrase", "multi_doc", "rerank_disambiguation", "citation_sensitive", "unanswerable"]},
        "answerable": {"type": "boolean"},
        "evidence_groups": {"type": "array", "items": {"$ref": "#/$defs/evidence_group"}},
        "acceptable_supporting_document_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/document_id"}},
        "irrelevant_or_disallowed_document_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/document_id"}},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "citation_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "required_evidence_group_ids", "minimum_distinct_documents", "forbid_citations", "notes"],
          "properties": {
            "required": {"type": "boolean"},
            "required_evidence_group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "minimum_distinct_documents": {"type": "integer", "minimum": 0},
            "forbid_citations": {"type": "boolean"},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "v1_trace": {"type": "object"},
        "gold_review": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "semantics_changed", "audit_reasons", "audit_notes"],
          "properties": {
            "status": {"const": "REVIEWED"},
            "semantics_changed": {"type": "boolean"},
            "audit_reasons": {
              "type": "array", "uniqueItems": true,
              "items": {"enum": ["ALTERNATIVE_DOCUMENT_EQUIVALENT", "LEXICAL_REQUIREMENT_REMOVED", "CLAIM_SPLIT", "AMBIGUOUS_EXPECTATION_CLARIFIED", "EVIDENCE_GROUP_REMODELED"]}
            },
            "audit_notes": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
