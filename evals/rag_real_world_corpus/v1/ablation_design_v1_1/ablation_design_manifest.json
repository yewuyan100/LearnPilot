      "bm25_score": "number or null; raw observed value",
      "bm25_rank": "integer or null; raw observed branch rank",
      "dense_fusion_rank": "integer or null; null when Dense did not admit",
      "bm25_fusion_rank": "integer or null; null when BM25 did not admit"
    },
    "unavailable_value_rule": "A value not observed in a branch remains null.",
    "observed_but_nonadmitting_rule": "Observed raw score/rank provenance is retained even when that branch does not admit the candidate; only that branch's fusion-rank contribution becomes null.",
    "identity_merge_rule": "Deduplicate by stable runtime chunk identity after branch admission and before RRF; fail on identity/content-hash collision.",
    "dual_hit_example": {
      "dense_score": 0.31,
      "dense_rank": 8,
      "bm25_score": "actual observed BM25 value",
      "bm25_rank": 3,
      "branch_admitted_dense": false,
      "branch_admitted_bm25": true,
      "candidate_admitted": true,
      "admission_basis": "BM25_TOP18",
      "dense_fusion_rank": null,
      "bm25_fusion_rank": 3,
      "rrf_contributing_branches": ["bm25"]
    }
  },
  "candidate_budget": {
    "raw_dense_top_18": "First 18 raw Dense retrieval results before dense admission.",
    "raw_bm25_top_18": "First 18 raw lexical retrieval results; membership is BM25 admission.",
    "maximum_branch_admitted_entries_before_identity_dedup": 36,
    "maximum_admitted_union_identities_after_identity_dedup": 36,
    "fused_top_18": "First at most 18 admitted union identities after deterministic RRF ordering.",
