    "rank_start": 1,
    "branch_weights": {
      "dense": 1.0,
      "bm25": 1.0
    },
    "input": "Only candidate_admitted identities and only branches whose branch_admitted flag is true.",
    "missing_or_nonadmitting_branch_contribution": 0.0,
    "limit_after_fusion": 18,
    "tie_break_order": [
      "best admitted branch fusion rank ascending",
      "dense_fusion_rank ascending with null last",
      "bm25_fusion_rank ascending with null last",
      "stable_chunk_id ascending"
    ],
    "raw_scores_are_telemetry_only": true,
    "tuning_in_v1_1": false
  },
