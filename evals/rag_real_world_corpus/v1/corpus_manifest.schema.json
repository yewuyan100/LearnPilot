{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-real-world-corpus-manifest-v1.json",
  "title": "LearnPilot RAG Real-world Corpus Manifest V1",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_version",
    "acquired_at",
    "document_count",
    "format_plan",
    "topic_plan",
    "licenses",
    "documents"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_id": {"const": "learnpilot-rag-real-world-corpus"},
    "corpus_version": {"const": "v1"},
    "acquired_at": {"type": "string", "format": "date-time"},
    "document_count": {"type": "integer", "minimum": 8, "maximum": 15},
    "format_plan": {
      "type": "object",
      "required": ["md", "txt", "pdf"],
      "additionalProperties": false,
      "properties": {
        "md": {"type": "integer", "minimum": 1},
        "txt": {"type": "integer", "minimum": 1},
        "pdf": {"type": "integer", "minimum": 2}
      }
    },
    "topic_plan": {
      "type": "object",
      "required": ["rag_retrieval", "agent_engineering", "ai_app_backend", "evaluation_reliability"],
      "additionalProperties": false,
      "properties": {
        "rag_retrieval": {"type": "integer", "minimum": 1},
        "agent_engineering": {"type": "integer", "minimum": 1},
        "ai_app_backend": {"type": "integer", "minimum": 1},
        "evaluation_reliability": {"type": "integer", "minimum": 1}
      }
    },
    "licenses": {"type": "array", "minItems": 1},
    "documents": {
      "type": "array",
      "minItems": 8,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "title",
        "topic_cluster",
        "source_format",
        "repository_path",
        "upstream_project",
        "upstream_repository",
        "upstream_commit_sha",
        "upstream_path_or_source",
        "retrieved_at",
        "license",
        "license_source",
        "license_repository_path",
        "license_sha256",
        "attribution",
        "source_sha256",
        "corpus_sha256",
        "transformation",
        "language",
        "notes"
      ],
      "properties": {
        "document_id": {"type": "string", "pattern": "^rw-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "topic_cluster": {"enum": ["rag_retrieval", "agent_engineering", "ai_app_backend", "evaluation_reliability"]},
        "source_format": {"enum": ["md", "txt", "pdf"]},
        "repository_path": {"type": "string", "pattern": "^evals/rag_real_world_corpus/v1/corpus/"},
        "upstream_project": {"type": "string", "minLength": 1},
        "upstream_repository": {"type": "string", "pattern": "^https://github.com/"},
        "upstream_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "upstream_path_or_source": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "license": {"enum": ["MIT", "Apache-2.0", "CC-BY-4.0"]},
        "license_source": {"type": "string", "pattern": "^https://github.com/.+/blob/[0-9a-f]{40}/"},
        "license_repository_path": {"type": "string", "pattern": "^evals/rag_real_world_corpus/v1/provenance/licenses/"},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "attribution": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "transformation": {"type": "object", "required": ["method"]},
        "language": {"const": "en"},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
