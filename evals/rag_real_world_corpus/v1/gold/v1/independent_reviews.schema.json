{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-real-world-independent-reviews-v1.json",
  "title": "LearnPilot RAG Real-world Gold V1 Independent Reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_version", "reviewer_mode", "verification_scope", "draft_file_sha256", "review_count", "verified_count", "reviews"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_version": {"const": "real-world-gold-review-v1"},
    "reviewer_mode": {"const": "FRESH_CORPUS_EVIDENCE_PASS"},
    "verification_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["structural_contract_validation", "frozen_corpus_locator_revalidation", "anchor_hash_recomputation", "independent_semantic_rejudgment_performed"],
      "properties": {
        "structural_contract_validation": {"const": true},
        "frozen_corpus_locator_revalidation": {"const": true},
        "anchor_hash_recomputation": {"const": true},
        "independent_semantic_rejudgment_performed": {"const": false}
      }
    },
    "draft_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_count": {"const": 72},
    "verified_count": {"const": 72},
    "reviews": {
      "type": "array", "minItems": 72, "maxItems": 72,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "verification_status", "review_reason", "reviewer_mode", "review_version", "checks", "claim_reviews", "evidence_reviews"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^rw-gold-v1-[a-z0-9-]+$"},
          "verification_status": {"const": "VERIFIED"},
          "review_reason": {"type": "string", "minLength": 20},
          "reviewer_mode": {"const": "FRESH_CORPUS_EVIDENCE_PASS"},
          "review_version": {"const": "real-world-gold-review-v1"},
          "checks": {
            "type": "object", "additionalProperties": false,
            "required": ["question_field_present", "answerability_contract_structure_valid", "claim_group_references_resolve", "evidence_anchors_recomputed", "evidence_role_sets_disjoint", "citation_contract_structurally_valid", "case_type_structurally_valid", "duplicate_question_heuristics_passed", "independent_semantic_rejudgment_performed"],
            "properties": {
              "question_field_present": {"const": true},
              "answerability_contract_structure_valid": {"const": true},
              "claim_group_references_resolve": {"const": true},
              "evidence_anchors_recomputed": {"const": true},
              "evidence_role_sets_disjoint": {"const": true},
              "citation_contract_structurally_valid": {"const": true},
              "case_type_structurally_valid": {"const": true},
              "duplicate_question_heuristics_passed": {"const": true},
              "independent_semantic_rejudgment_performed": {"const": false}
            }
          },
          "claim_reviews": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim_id", "binding_status", "semantic_rejudgment", "evidence_group_ids", "rationale"],
              "properties": {
                "claim_id": {"type": "string", "minLength": 1},
                "binding_status": {"enum": ["EVIDENCE_GROUP_BINDING_VERIFIED", "NEAR_BOUNDARY_ANCHOR_BINDING_VERIFIED"]},
                "semantic_rejudgment": {"const": "NOT_PERFORMED"},
                "evidence_group_ids": {"type": "array", "items": {"type": "string"}},
                "rationale": {"type": "string", "minLength": 20}
              }
            }
          },
          "evidence_reviews": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["evidence_id", "document_id", "locator_kind", "anchor_hash_recomputed", "locator_resolution", "source_binding_status"],
              "properties": {
                "evidence_id": {"type": "string", "minLength": 1},
                "document_id": {"type": "string", "minLength": 1},
                "locator_kind": {"enum": ["SOURCE_LINES", "PDF_PAGE"]},
                "anchor_hash_recomputed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "locator_resolution": {"const": "PASS"},
                "source_binding_status": {"const": "PASS"}
              }
            }
          }
        }
      }
    }
  }
}
