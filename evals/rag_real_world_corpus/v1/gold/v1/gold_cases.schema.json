{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-real-world-gold-v1.json",
  "title": "LearnPilot RAG Real-world Gold Dataset V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_ref", "dataset_id", "dataset_version", "corpus_ref", "case_count", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_ref": {"const": "learnpilot-rag-eval-gold-contract-v2"},
    "dataset_id": {"const": "learnpilot-rag-real-world-gold"},
    "dataset_version": {"const": "v1"},
    "corpus_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "corpus_version"],
      "properties": {
        "corpus_id": {"const": "learnpilot-rag-real-world-corpus"},
        "corpus_version": {"const": "v1"}
      }
    },
    "case_count": {"const": 72},
    "cases": {"type": "array", "minItems": 72, "maxItems": 72, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "document_id": {"type": "string", "pattern": "^rw-[a-z0-9-]+$"},
    "evidence_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_group_id", "required", "evidence_role", "any_of_document_ids", "any_of_evidence_ids", "notes"],
      "properties": {
        "evidence_group_id": {"type": "string", "pattern": "^eg-rw-[a-z0-9-]+$"},
        "required": {"const": true},
        "evidence_role": {"const": "REQUIRED"},
        "any_of_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/document_id"}},
        "any_of_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev-rw-[a-z0-9-]+$"}},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "evidence_role_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "evidence_ids", "evidence_role", "notes"],
      "properties": {
        "document_id": {"$ref": "#/$defs/document_id"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev-rw-[a-z0-9-]+$"}},
        "evidence_role": {"enum": ["ACCEPTABLE_SUPPORT", "UNSUPPORTED"]},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "canonical_claim", "required", "evaluation_mode", "evidence_group_ids", "notes"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^rw-gold-v1-[a-z0-9-]+-claim-[0-9]{2}$"},
        "canonical_claim": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "evaluation_mode": {"enum": ["STRUCTURED_EXACT", "NUMERIC_EXACT", "IDENTIFIER_EXACT", "SEMANTIC_REVIEW", "ANSWERABILITY_ONLY"]},
        "evidence_group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "deterministic_match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "all_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "ordered_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "tier", "case_type", "information_need_key", "question", "query_language", "expected_answer_language", "primary_topic", "secondary_topics", "difficulty", "answerable", "evidence_groups", "acceptable_supporting_evidence", "plausible_distractor_documents", "claims", "citation_contract", "verification"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^rw-gold-v1-[a-z0-9-]+$"},
        "tier": {"enum": ["CORE", "STRESS"]},
        "case_type": {"enum": ["single_doc_fact", "semantic_paraphrase", "long_doc_localization", "multi_doc_synthesis", "source_disambiguation", "unanswerable_near_boundary", "deep_long_doc_localization", "cross_topic_multi_doc", "high_overlap_source_conflict"]},
        "information_need_key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "question": {"type": "string", "minLength": 8},
        "query_language": {"enum": ["zh-CN", "en"]},
        "expected_answer_language": {"enum": ["zh-CN", "en"]},
        "primary_topic": {"enum": ["rag_retrieval", "agent_engineering", "ai_app_backend", "evaluation_reliability"]},
        "secondary_topics": {"type": "array", "uniqueItems": true, "items": {"enum": ["rag_retrieval", "agent_engineering", "ai_app_backend", "evaluation_reliability"]}},
        "difficulty": {"enum": ["easy", "medium", "hard", "stress"]},
        "answerable": {"type": "boolean"},
        "localization_region": {"enum": ["early", "middle", "deep", "mixed", "not_applicable"]},
        "evidence_groups": {"type": "array", "items": {"$ref": "#/$defs/evidence_group"}},
        "acceptable_supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_role_record"}},
        "plausible_distractor_documents": {"type": "array", "items": {"$ref": "#/$defs/evidence_role_record"}},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "citation_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["citation_required", "required_evidence_group_ids", "minimum_distinct_required_documents", "acceptable_support_policy", "forbid_citations", "notes"],
          "properties": {
            "citation_required": {"type": "boolean"},
            "required_evidence_group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "minimum_distinct_required_documents": {"type": "integer", "minimum": 0},
            "acceptable_support_policy": {"enum": ["ALLOW_GENUINE_SUPPORT", "REQUIRED_ONLY", "NO_CORPUS_CITATIONS"]},
            "forbid_citations": {"type": "boolean"},
            "notes": {"type": "string", "minLength": 1}
          }
        },
        "unanswerable_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["near_boundary_document_ids", "near_boundary_evidence_ids", "absent_information", "unsupported_factual_answer_forbidden", "fabricated_citation_forbidden"],
          "properties": {
            "near_boundary_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/document_id"}},
            "near_boundary_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "absent_information": {"type": "string", "minLength": 1},
            "unsupported_factual_answer_forbidden": {"const": true},
            "fabricated_citation_forbidden": {"const": true}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verification_status", "review_reason", "reviewer_mode", "review_version"],
          "properties": {
            "verification_status": {"const": "VERIFIED"},
            "review_reason": {"type": "string", "minLength": 1},
            "reviewer_mode": {"const": "FRESH_CORPUS_EVIDENCE_PASS"},
            "review_version": {"const": "real-world-gold-review-v1"}
          }
        }
      }
    }
  }
}
