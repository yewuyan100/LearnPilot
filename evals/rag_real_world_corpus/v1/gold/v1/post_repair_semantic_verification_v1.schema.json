{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/post-repair-semantic-verification-v1.json",
  "title": "LearnPilot Post-repair Semantic Verification V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_version", "review_date", "frozen_pre_repair_review", "post_repair_gold_sha256", "review_method", "repaired_semantic_claim_total", "claim_reviews", "previously_supported_and_unchanged", "previously_supported_claim_payload_proof", "evidence_role_closure", "final_semantic_closure", "execution_audit"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_version": {"const": "post-repair-semantic-verification-v1"},
    "review_date": {"type": "string", "minLength": 1},
    "frozen_pre_repair_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "post_repair_gold_sha256": {"$ref": "#/$defs/sha256"},
    "review_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incremental_semantic_closure", "previously_supported_claim_payloads_compared", "fresh_repaired_claim_review", "fresh_corpus_reopen", "llm_used", "baseline_output_used", "retrieval_output_used", "production_rag_used"],
      "properties": {
        "incremental_semantic_closure": {"const": true},
        "previously_supported_claim_payloads_compared": {"const": 96},
        "fresh_repaired_claim_review": {"const": true},
        "fresh_corpus_reopen": {"const": true},
        "llm_used": {"const": false},
        "baseline_output_used": {"const": false},
        "retrieval_output_used": {"const": false},
        "production_rag_used": {"const": false}
      }
    },
    "repaired_semantic_claim_total": {"const": 8},
    "claim_reviews": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/claim_review"}},
    "previously_supported_and_unchanged": {"const": 96},
    "previously_supported_claim_payload_proof": {"type": "array", "minItems": 96, "maxItems": 96, "items": {"$ref": "#/$defs/hash_proof"}},
    "evidence_role_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_case_count", "case_reviews", "misclassified_count"],
      "properties": {
        "target_case_count": {"const": 14},
        "case_reviews": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/role_case_review"}},
        "misclassified_count": {"const": 0}
      }
    },
    "final_semantic_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_review_total", "previously_supported_and_unchanged", "repaired_semantic_claims_reviewed", "verdict_distribution", "status"],
      "properties": {
        "semantic_review_total": {"const": 104},
        "previously_supported_and_unchanged": {"const": 96},
        "repaired_semantic_claims_reviewed": {"const": 8},
        "verdict_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "AMBIGUOUS"],
          "properties": {
            "SUPPORTED": {"const": 104},
            "PARTIALLY_SUPPORTED": {"const": 0},
            "UNSUPPORTED": {"const": 0},
            "AMBIGUOUS": {"const": 0}
          }
        },
        "status": {"const": "PASS"}
      }
    },
    "execution_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deepseek_calls", "other_llm_calls", "production_rag_ask_calls", "real_world_baseline_executions", "embedding_executions", "faiss_retrieval_executions"],
      "properties": {
        "deepseek_calls": {"const": 0}, "other_llm_calls": {"const": 0}, "production_rag_ask_calls": {"const": 0},
        "real_world_baseline_executions": {"const": 0}, "embedding_executions": {"const": 0}, "faiss_retrieval_executions": {"const": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "pre_repair_sha256", "post_repair_sha256", "unchanged"],
      "properties": {"claim_id": {"type": "string"}, "pre_repair_sha256": {"$ref": "#/$defs/sha256"}, "post_repair_sha256": {"$ref": "#/$defs/sha256"}, "unchanged": {"const": true}}
    },
    "locator": {"type": "object", "minProperties": 3},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "document_id", "locator", "source_bytes_sha256", "fresh_text_sha256", "fresh_evidence_excerpt", "locator_resolved", "source_hash_matches_manifest", "anchor_hash_matches", "candidate_semantic_verdict", "review_reason"],
      "properties": {
        "evidence_id": {"type": "string"}, "document_id": {"type": "string"}, "locator": {"$ref": "#/$defs/locator"},
        "source_bytes_sha256": {"$ref": "#/$defs/sha256"}, "fresh_text_sha256": {"$ref": "#/$defs/sha256"},
        "fresh_evidence_excerpt": {"type": "string", "minLength": 1}, "locator_resolved": {"const": true},
        "source_hash_matches_manifest": {"const": true}, "anchor_hash_matches": {"const": true},
        "candidate_semantic_verdict": {"const": "SUPPORTED"}, "review_reason": {"type": "string", "minLength": 1}
      }
    },
    "group_review": {
      "type": "object", "additionalProperties": false,
      "required": ["group_id", "logic", "candidate_anchors", "group_verdict", "review_reason"],
      "properties": {"group_id": {"type": "string"}, "logic": {"const": "OR"}, "candidate_anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}, "group_verdict": {"const": "SUPPORTED"}, "review_reason": {"type": "string", "minLength": 1}}
    },
    "claim_review": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "claim_id", "question", "claim", "old_verdict", "new_verdict", "group_combination_logic", "new_evidence_groups", "claim_verdict", "review_reason", "fresh_corpus_reopen", "authoring_verdict_used"],
      "properties": {
        "case_id": {"type": "string"}, "claim_id": {"type": "string"}, "question": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1},
        "old_verdict": {"const": "PARTIALLY_SUPPORTED"}, "new_verdict": {"const": "SUPPORTED"}, "group_combination_logic": {"const": "AND"},
        "new_evidence_groups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group_review"}}, "claim_verdict": {"const": "SUPPORTED"},
        "review_reason": {"type": "string", "minLength": 1}, "fresh_corpus_reopen": {"const": true}, "authoring_verdict_used": {"const": false}
      }
    },
    "role": {
      "type": "object", "additionalProperties": false, "required": ["document_id", "role"],
      "properties": {"document_id": {"type": "string"}, "role": {"enum": ["REQUIRED", "ACCEPTABLE_SUPPORT", "UNSUPPORTED"]}}
    },
    "role_case_review": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "review_mode", "roles", "role_verdict", "review_reason"],
      "properties": {"case_id": {"type": "string"}, "review_mode": {"enum": ["FRESH_POST_REPAIR_REVIEW", "UNCHANGED_PREVIOUSLY_CONFIRMED"]}, "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/role"}}, "role_verdict": {"const": "VERIFIED"}, "review_reason": {"type": "string", "minLength": 1}}
    }
  }
}
