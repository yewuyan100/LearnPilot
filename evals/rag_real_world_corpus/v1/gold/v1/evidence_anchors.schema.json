{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-real-world-evidence-anchors-v1.json",
  "title": "LearnPilot Stable Evidence Anchors V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_ref", "anchor_count", "anchors"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_ref": {"type": "object"},
    "anchor_count": {"type": "integer", "minimum": 1},
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "document_id", "locator", "anchor_text_hash", "excerpt", "language", "notes"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^ev-rw-[a-z0-9-]+$"},
          "document_id": {"type": "string", "pattern": "^rw-[a-z0-9-]+$"},
          "locator": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "source_path", "start_line", "end_line", "section_title", "region"],
                "properties": {
                  "kind": {"const": "SOURCE_LINES"}, "source_path": {"type": "string"},
                  "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
                  "section_title": {"type": ["string", "null"]}, "region": {"enum": ["early", "middle", "deep"]}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "source_path", "page_number", "region"],
                "properties": {
                  "kind": {"const": "PDF_PAGE"}, "source_path": {"type": "string"},
                  "page_number": {"type": "integer", "minimum": 1}, "region": {"enum": ["early", "middle", "deep"]}
                }
              }
            ]
          },
          "anchor_text_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 420},
          "language": {"const": "en"},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
