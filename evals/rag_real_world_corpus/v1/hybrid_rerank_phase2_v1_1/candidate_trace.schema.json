{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnpilot.local/schemas/rag-hybrid-rerank-phase2-v1-1-candidate.json",
  "title": "LearnPilot RAG Hybrid Rerank Phase 2 V1.1 Candidate Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "document_id",
    "chunk_index",
    "content_hash",
    "filename",
    "page_number",
    "section_title",
    "raw_text",
    "material_id",
    "chunk_id",
    "evidence_ids",
    "dense_score",
    "dense_rank",
    "branch_admitted_dense",
    "dense_fusion_rank",
    "bm25_score",
    "bm25_rank",
    "branch_admitted_bm25",
    "bm25_fusion_rank",
    "candidate_admitted",
    "fusion_score",
    "fusion_rank",
    "reranker_score",
    "reranker_rank",
    "reranker_truncated",
    "reranker_input_tokens",
    "governance_input_rank",
    "selected",
    "selected_text_chars",
    "rejection_reason",
    "arm"
  ],
  "properties": {
    "identity": { "type": "string", "minLength": 68 },
    "document_id": { "type": "string", "minLength": 1 },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "filename": { "type": "string", "minLength": 1 },
    "page_number": { "type": ["integer", "null"], "minimum": 1 },
    "section_title": { "type": ["string", "null"] },
    "raw_text": { "type": "string" },
    "material_id": { "type": "integer", "minimum": 1 },
    "chunk_id": { "type": "integer", "minimum": 1 },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "dense_score": { "type": ["number", "null"] },
    "dense_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
    "branch_admitted_dense": { "type": "boolean" },
    "dense_fusion_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
    "bm25_score": { "type": ["number", "null"] },
    "bm25_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
    "branch_admitted_bm25": { "type": "boolean" },
    "bm25_fusion_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
    "candidate_admitted": { "type": "boolean" },
    "fusion_score": { "type": ["number", "null"] },
    "fusion_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 36 },
    "reranker_score": { "type": ["number", "null"] },
    "reranker_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
    "reranker_truncated": { "type": ["boolean", "null"] },
    "reranker_input_tokens": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 },
    "governance_input_rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 18 },
    "selected": { "type": "boolean" },
    "selected_text_chars": { "type": ["integer", "null"], "minimum": 1, "maximum": 2200 },
    "rejection_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "dense_ineligible",
        "not_admitted",
        "fused_top18_cutoff",
        "overlap_dedup",
        "diversity_deferred",
        "final_top_k",
        "context_budget",
        "empty_content"
      ]
    },
    "arm": { "enum": ["B", "C", "D"] }
  }
}
