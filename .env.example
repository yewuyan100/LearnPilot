APP_NAME=PersonalLearning
APP_VERSION=4.0.0
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/personal_learning.sqlite3
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS=.pdf,.md,.markdown,.txt
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DEMO_DATA_ENABLED=false
MATERIAL_CHUNK_SIZE=800
MATERIAL_CHUNK_OVERLAP=120
MATERIAL_MIN_CHUNK_SIZE=80
HF_HOME=D:/AIModels/HuggingFace
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=local-cache
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_NORMALIZE=true
FAISS_INDEX_PATH=./data/materials.faiss
FAISS_MANIFEST_PATH=./data/materials.faiss.manifest.json
SEARCH_TOP_K_DEFAULT=5
SEARCH_TOP_K_MAX=20
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
RAG_TOP_K_DEFAULT=6
RAG_TOP_K_MAX=12
RAG_MIN_SCORE=0.35
RAG_MAX_SOURCES=6
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_CHUNK_CHARS=2200
RAG_HISTORY_MESSAGES=6
RAG_HISTORY_CHARS=6000
RAG_QUERY_REWRITE_ENABLED=true
RAG_MAX_QUESTION_CHARS=2000
RAG_PROMPT_VERSION=rag-answer-v1
RAG_REWRITE_PROMPT_VERSION=rag-rewrite-v1
RAG_CITATION_EXCERPT_CHARS=800
ACTIVITY_MAX_QUESTION_COUNT=20
ACTIVITY_DEFAULT_QUESTION_COUNT=8
ACTIVITY_MAX_SOURCES=8
ACTIVITY_MAX_CONTEXT_CHARS=16000
ACTIVITY_MAX_CHUNK_CHARS=2400
ACTIVITY_GENERATION_PROMPT_VERSION=activity-generation-v1
ACTIVITY_GENERATION_MAX_OUTPUT_TOKENS=6000
SHORT_ANSWER_GRADING_PROMPT_VERSION=short-answer-grading-v1
SHORT_ANSWER_MAX_CHARS=4000
SHORT_ANSWER_GRADING_TEMPERATURE=0.0
SHORT_ANSWER_GRADING_MAX_RETRIES=1
WRONG_ANSWER_SHORT_ANSWER_THRESHOLD=0.6
QUESTION_SOURCE_EXCERPT_CHARS=800
VITE_API_BASE_URL=http://127.0.0.1:8000/api
